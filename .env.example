DEEPSEEK_API_KEY=your_deepseek_api_key
TRANSLATION_PROVIDER=deepseek
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
DEEPSEEK_TRANSLATION_MODEL=deepseek-chat
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_TRANSLATION_MODEL=qwen3.5-4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=qwen3.5:4b
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PYANNOTE_AUTH_TOKEN=
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
PYANNOTE_DEVICE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
YTDLP_ENABLE_DEFAULT_COOKIES_FILE=0
YTDLP_REMOTE_COMPONENTS=
YTDLP_CONCURRENT_FRAGMENTS=3
YTDLP_SUBPROCESS_TIMEOUT_SEC=300
MAX_VIDEO_DURATION_SEC=7200
MAX_AUDIO_BYTES=524288000
MAX_TRANSCRIPT_CHARS=250000
MAX_TRANSLATION_SEGMENTS=1000
TMP_ARTIFACT_TTL_HOURS=24
JOB_RUN_ATTACH_SPEAKERS=0
JOB_STAGE_TIMEOUT_INSPECT_SEC=45
JOB_STAGE_TIMEOUT_FETCH_SOURCE_SEC=180
JOB_STAGE_TIMEOUT_TRANSCRIBE_SEC=900
JOB_STAGE_TIMEOUT_TRANSLATE_SEC=900
JOB_STAGE_TIMEOUT_PERSIST_SEC=30
JOB_QUEUE_DB_PATH=tmp/job_queue.sqlite
JOB_QUEUE_LEASE_SECONDS=1800
JOB_QUEUE_HEARTBEAT_SECONDS=30
ACCOUNT_QUOTA_DB_PATH=tmp/account_quota.sqlite
ACCOUNT_DAILY_REQUEST_LIMIT=0
ACCOUNT_MAX_CONCURRENT_JOBS=0
ACCOUNT_MAX_HISTORY_SESSIONS=0
API_AUTH_TOKEN=
API_RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY_HEADERS=0
DEPLOYMENT_PROFILE=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8090,http://127.0.0.1:8090
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Same value as backend API_AUTH_TOKEN so the web app can call /api/* locally (exposed to browser; do not use in production).
NEXT_PUBLIC_API_AUTH_TOKEN=
NEXT_PUBLIC_DEFAULT_TRANSLATION_PROVIDER=deepseek
